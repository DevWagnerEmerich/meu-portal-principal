
# Configuração do Banco de Dados
# Para SQLite (Local): Deixe DATABASE_URL vazio
# Para Supabase (Produção/Nuvem): Preencha com a URL do Supabase
DATABASE_URL=

# Configuração Padrão
PORT=3000
NODE_ENV=development
SESSION_SECRET=sua_chave_secreta_aqui

# Configuração de E-mail (Gmail)
# Gere uma senha de app em: https://myaccount.google.com/apppasswords
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_de_app

# Configuração Mercado Pago
MP_ACCESS_TOKEN=seu_access_token
MP_PUBLIC_KEY=sua_public_key
MP_WEBHOOK_SECRET=seu_webhook_secret
DOMAIN=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# Next.js Variáveis Públicas (Prefixo NEXT_PUBLIC_ = acessível no browser)
NEXT_PUBLIC_MP_PUBLIC_KEY=sua_public_key_mp   # Mesmo que MP_PUBLIC_KEY, mas exposta ao frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

